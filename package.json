{
  "name": "maprunner",
  "author": "Simon Errington",
  "license": "MIT",
  "type": "module",
  "version": "1.2.1",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "build": "cross-env NODE_ENV=production npm-run-all clean -p build:*",
    "dbgbuild:11ty": "set DEBUG=Eleventy* & eleventy --quiet",
    "build:11ty": "eleventy --quiet",
    "clean": "rimraf dist",
    "dev": "npm-run-all clean build:* -p dev:*",
    "dev:11ty": "eleventy --serve"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.7",
    "@11ty/eleventy-img": "^6.0.4",
    "@11ty/eleventy-navigation": "^1.0.5",
    "@tailwindcss/postcss": "^4.3.0",
    "baseline-browser-mapping": "^2.11.29",
    "cross-env": "^10.1.0",
    "cssnano": "^8.0.1",
    "eleventy-plugin-excerpt": "^1.1.2",
    "eleventy-plugin-safe-external-links": "^0.1.5",
    "npm-run-all": "^4.1.5",
    "only-allow": "^1.2.2",
    "postcss": "^8.5.15",
    "prettier": "^3.8.3",
    "rimraf": "^6.1.3",
    "slug": "^12.0.1",
    "tailwindcss": "^4.3.0"
  },
  "dependencies": {}
}