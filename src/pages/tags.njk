---
permalink: "tags/"
---
{% extends 'page.njk' %}
{% block body %}
  <h1>Tags</h1>
  <ol class="tagscloud">
    {% for tag in collections.tags %}
      {% set tagUrl %}/tag/{{ tag.tag | slugify }}/{% endset %}
      <li>
        <a href="{{ tagUrl | url }}" class="tag{{ tag.step }}" rel="tag">{{ tag.tag }}</a>
      </li>
    {% endfor %}
  </ol>
{% endblock %}